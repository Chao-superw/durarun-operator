# ── Builder ──────────────────────────────────────────────────────────
FROM golang:1.26 AS builder
WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/operator ./cmd/operator/main.go

# ── Runtime ──────────────────────────────────────────────────────────
FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/operator /operator
USER 65532:65532
ENTRYPOINT ["/operator"]
